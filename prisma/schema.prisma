generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  pinHash       String
  createdAt     DateTime     @default(now())
  accounts      Account[]
  creditCards   CreditCard[]
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Account {
  id            String        @id @default(cuid())
  accountNumber String        @unique @default(cuid())
  type          String        @default("checking")
  balance       Decimal       @default(1000.00) @db.Decimal(12, 2)
  frozen        Boolean       @default(false)
  frozenReason  String?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentTx        Transaction[] @relation("SenderAccount")
  receivedTx    Transaction[] @relation("ReceiverAccount")
  createdAt     DateTime      @default(now())
}

model Transaction {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  externalLabel String?
  status       String   @default("completed")
  fromId       String?
  from         Account? @relation("SenderAccount", fields: [fromId], references: [id])
  toId         String?
  to           Account? @relation("ReceiverAccount", fields: [toId], references: [id])
  createdAt    DateTime @default(now())
}

model CreditCard {
  id           String            @id @default(cuid())
  cardNumber   String            @unique @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal           @default(0) @db.Decimal(12, 2)
  creditLimit  Decimal           @default(2000.00) @db.Decimal(12, 2)
  status       String            @default("active")
  createdAt    DateTime          @default(now())
  transactions CardTransaction[]
}

model CardTransaction {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  merchant  String
  amount    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
}